# Public browser configuration. These values are safe to expose in a Vite bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Must match AUTH_EMAIL_DOMAIN configured for the Supabase Edge Functions.
VITE_AUTH_EMAIL_DOMAIN=auth.corpsignal.invalid
VITE_ADMIN_USERS_FUNCTION=admin-users
VITE_MEDIA_FUNCTION=media
